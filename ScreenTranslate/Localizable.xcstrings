    "Create this two-action shortcut once. Lightweight results appear without opening the app; dismiss the preview to return to your screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create this two-action shortcut once. Lightweight results appear without opening the app; dismiss the preview to return to your screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置好这两个操作后，结果将通过系统轻量预览显示，无需打开主 App。收起预览即可返回原来的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定好這兩個操作後，結果將透過系統輕量預覽顯示，無需開啟主 App。收起預覽即可返回原來的介面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この2アクションのショートカットを一度作成します。 軽量の結果は、アプリを開くことなく表示されます。 プレビューを解除して、画面に戻ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez ce raccourci à deux actions une fois. Les résultats légers apparaissent sans ouvrir l'application ; rejetez l'aperçu pour revenir à votre écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree este atajo de dos acciones una vez. Los resultados de peso ligero aparecen sin abrir la aplicación; descargue la vista previa para volver a su pantalla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 두 액션 단축키를 한 번 만듭니다. 라이트급 선수는 앱을 열지 않고 나타납니다. 미리보기를 화면으로 돌려 놓습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie este atalho de duas ações uma vez. Os resultados leves aparecem sem abrir o aplicativo; descarte a visualização para retornar à tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creare questa scorciatoia a due azioni una volta. I risultati dei pesi leggeri appaiono senza aprire l'applicazione; respingere l'anteprima per tornare alla schermata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie diese Verknüpfung mit zwei Aktionen einmal.Leichtgewichtige Ergebnisse werden angezeigt, ohne die App zu öffnen; sperren Sie die Vorschau ab, um zu Ihrem Bildschirm zurückzukehren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصنعي هذا الطريق المختصر ذات مرة نتائج الوزن الخفيف تظهر بدون ان تفتحي التطبيق"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте этот ярлык с двумя действиями один раз. Легкие результаты появляются без открытия приложения; отклоните предварительный просмотр, чтобы вернуться на экран."
          }
        }
      }
    },
    "In Shortcuts, add the two actions shown above in that order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Shortcuts, add the two actions shown above in that order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快捷指令中，按顺序加入上方两个操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在快捷指令中，按順序加入上方兩個操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでは、上記の2つのアクションを順番に追加します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Raccourcis, ajouter les deux actions indiquées ci-dessus dans cet ordre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los atajos, agregue las dos acciones que se muestran anteriormente en ese orden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts에서 위의 두 가지 작업을 추가하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Atalhos, adicione as duas ações mostradas acima nessa ordem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle scorciatoie, aggiungere le due azioni sopra indicate in quell'ordine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie in Shortcuts die beiden oben gezeigten Aktionen in dieser Reihenfolge hinzu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "In Shortcuts, add the two actions shown above in that order."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ярлыках добавьте два действия, показанные выше в этом порядке."
          }
        }
      }
    },
