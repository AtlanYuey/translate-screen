      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the AI engines you selected send data. Your provider may charge for requests and apply its own retention policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅所选 AI 引擎会发送数据。服务商可能收取费用，并按其政策保留数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅所選 AI 引擎會傳送資料。服務商可能收取費用，並按其政策保留資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したAIエンジンのみが送信します。外部料金やプロバイダーのデータ保存方針が適用されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les moteurs IA choisis envoient des données. Le fournisseur peut facturer et appliquer sa politique de conservation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los motores de IA elegidos envían datos. El proveedor puede cobrar y conservarlos según su política."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 AI 엔진만 데이터를 전송합니다. 제공업체가 요금을 청구하고 자체 정책에 따라 데이터를 보관할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente os mecanismos de IA escolhidos enviam dados. O provedor pode cobrar e reter dados conforme sua política."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i motori IA scelti inviano dati. Il fornitore può applicare costi e conservare i dati secondo le sue regole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte KI-Engines senden Daten. Der Anbieter kann Gebühren erheben und Daten nach eigenen Regeln speichern."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترسل البيانات محركات الذكاء الاصطناعي المختارة فقط. قد يفرض المزود رسوماً ويحتفظ بالبيانات وفق سياسته."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные отправляют только выбранные движки ИИ. Поставщик может взимать плату и хранить данные по своим правилам."
          }
        }
      }
    },
    "Permission is remembered for this endpoint and model. You can revoke it in Privacy settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission is remembered for this endpoint and model. You can revoke it in Privacy settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会记住此服务地址与模型的许可，你可以在隐私设置中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會記住此服務地址與模型的許可，你可以在隱私設定中撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続先とモデルへの許可を記憶します。プライバシー設定で取り消せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accord est mémorisé pour cette adresse et ce modèle. Révoquez-le dans Confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso se recuerda para esta dirección y modelo. Puedes revocarlo en Privacidad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소와 모델에 대한 동의를 기억합니다. 개인정보 보호 설정에서 철회할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão vale para este endereço e modelo. Você pode revogá-la em Privacidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il consenso vale per indirizzo e modello. Puoi revocarlo in Privacy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe gilt für diese Adresse und dieses Modell. Unter Datenschutz widerrufbar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الإذن لهذا العنوان والنموذج. يمكنك إلغاؤه من إعدادات الخصوصية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласие сохраняется для адреса и модели. Его можно отозвать в разделе конфиденциальности."
          }
        }
      }
    },
