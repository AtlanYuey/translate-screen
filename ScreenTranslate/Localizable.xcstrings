          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des KI-Dienstes hat die Größenbegrenzung überschritten. Versuchen Sie es mit einem kleineren Screenshot."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابة خدمات \"آي آي\" تجاوزت الحد الأقصى، جربي شاشات أقل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реакция службы искусственного интеллекта превысила предел размера. Попробуйте сделать снимок экрана меньшего размера."
          }
        }
      }
    },
    "Could not reach the AI service securely. Check the endpoint and your connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the AI service securely. Check the endpoint and your connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全连接到 AI 服务，请检查地址与网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全連線到 AI 服務，請檢查地址與網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIサービスを安全に受けることができませんでした。エンドポイントと接続を確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'atteindre le service AI en toute sécurité. Vérifiez le paramètre et votre connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podía llegar al servicio AI de forma segura. Compruebe el punto final y su conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스에 안전하게 도달 할 수 없습니다. 엔드포인트와 연결을 확인하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o serviço de IA com segurança. Verifique o endpoint e sua conexão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile raggiungere il servizio AI in modo sicuro. Controllare il punto finale e la connessione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte den KI-Dienst nicht sicher erreichen. Überprüfen Sie den Endpunkt und Ihre Verbindung."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أستطع الوصول لخدمة (آي آي) بأمان تحقق من نقطة النهاية وعلاقتك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не смог безопасно добраться до службы искусственного интеллекта. Проверьте конечную точку и ваше соединение."
          }
        }
      }
    },
    "The AI service rejected access. Check the API key and model permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service rejected access. Check the API key and model permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服务拒绝访问，请检查密钥和模型权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
