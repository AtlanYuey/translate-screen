    "The next AI operation will ask before sending data. Requests already in progress are not recalled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next AI operation will ask before sending data. Requests already in progress are not recalled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次使用 AI 时会重新征求许可。已经发送的请求无法从服务商处撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次使用 AI 時會重新徵求許可。已經傳送的請求無法從服務商處撤回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のAI操作は、データを送信する前に尋ねます。 既に進行中のリクエストはリコールされません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine opération d'IA demandera avant d'envoyer des données. Les demandes déjà en cours ne sont pas rappelées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima operación de AI preguntará antes de enviar datos. Las solicitudes ya en curso no se recuerdan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 AI 작업은 데이터를 전송하기 전에 묻습니다. 진행중인 요청은 회신되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima operação de IA irá perguntar antes de enviar os dados. As solicitações já em andamento não são lembradas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima operazione AI chiederà prima di inviare i dati. Le richieste già in corso non vengono richiamate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste KI-Operation wird vor dem Senden von Daten fragen. Bereits laufende Anfragen werden nicht zurückgerufen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "The next AI operation will ask before sending data, requests already in progress are not recalled."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующая операция ИИ будет запрашивать перед отправкой данных. Запросы, уже находящиеся в процессе, не отзываются."
          }
        }
      }
    },
