    "Use an HTTPS Base URL without credentials, query parameters, or fragments. Include the provider’s API prefix, for example /v1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS Base URL without credentials, query parameters, or fragments. Include the provider’s API prefix, for example /v1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 地址，不要在网址中填写凭据、查询参数或片段，并包含服务商要求的前缀，例如 /v1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 HTTPS 地址，不要在網址中填寫憑據、查詢引數或片段，幷包含服務商要求的字首，例如 /v1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証、クエリパラメータ、またはフラグメントなしで HTTPS ベース URL を使用します。 プロバイダーの API プレフィックスを /v1 に含めます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une URL de base HTTPS sans identifiants, paramètres de requête ou fragments. Inclure le préfixe de l'API du fournisseur, par exemple /v1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una URL de la base HTTPS sin credenciales, parámetros de consulta o fragmentos. Incluya el prefijo de API del proveedor, por ejemplo /v1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "credentials, 쿼리 매개 변수, 또는 파편없이 HTTPS 기본 URL을 사용하십시오. 공급자의 API 접두사를 포함, 예를 들어 /v1."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma URL base HTTPS sem credenciais, parâmetros de pesquisa ou fragmentos. Inclua o prefixo API do provedor, por exemplo /v1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare un URL base HTTPS senza credenziali, parametri di query o frammenti. Includere il prefisso API del provider, per esempio /v1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine HTTPS-Basis-URL ohne Anmeldeinformationen, Abfrageparameter oder Fragmente und fügen Sie das API-Präfix des Anbieters hinzu, z. B. /v1."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(ج) استخدام قاعدة &quot; HTTPS &quot; بدون وثائق تفويض أو بارامترات استفسار أو شظايا، بما في ذلك نموذج &quot; API &quot; للمقدم، على سبيل المثال؛"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте URL-адрес базы HTTPS без учетных данных, параметров запроса или фрагментов.Включите префикс API провайдера, например /v1."
          }
        }
      }
    },
    "Enter a model name in the selected AI engine’s settings.": {
      "extractionState": "manual",
