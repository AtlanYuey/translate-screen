      }
    },
    "Each service keeps its own name, model and secure key. OCR and translation can use different services.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each service keeps its own name, model and secure key. OCR and translation can use different services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项服务独立保存名称、模型和安全密钥。识别与翻译可以分别选择不同服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每項服務獨立儲存名稱、模型和安全金鑰。識別與翻譯可以分別選擇不同服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスごとに名前・モデル・キーを保持します。文字認識と翻訳で別のサービスを選べます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque service conserve son nom, son modèle et sa clé. OCR et traduction peuvent utiliser des services différents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servicio conserva su nombre, modelo y clave. OCR y traducción pueden usar servicios diferentes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스별 이름, 모델, 키를 보관합니다. 문자 인식과 번역에 다른 서비스를 선택할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serviço mantém nome, modelo e chave. OCR e tradução podem usar serviços diferentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni servizio mantiene nome, modello e chiave. OCR e traduzione possono usare servizi diversi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Dienst behält Name, Modell und Schlüssel. OCR und Übersetzung können verschiedene Dienste nutzen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ كل خدمة باسمها ونموذجها ومفتاحها. يمكن اختيار خدمتين مختلفتين للتعرف والترجمة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого сервиса свои имя, модель и ключ. OCR и перевод могут использовать разные сервисы."
          }
        }
      }
    },
