    "Receives Take Screenshot and shows a lightweight translation preview without switching apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receives Take Screenshot and shows a lightweight translation preview without switching apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收“截屏”动作的图片，无需切换 App 即可查看轻量翻译预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收「截圖」動作的圖片，無需切換 App 即可查看輕量翻譯預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮って、アプリを切り替えずに軽量な翻訳プレビューを表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçoit Capture d'écran et affiche un aperçu de traduction léger sans changer d'applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibis Take Captura de Pantalla y muestra una vista previa de traducción ligera sin cambiar aplicaciones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 샷을 수신하고 앱을 전환하지 않고 가벼운 번역 미리보기를 보여줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recebe Captura de tela e mostra uma visualização leve da tradução sem mudar de aplicativos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi Prendere Screenshot e mostra un'anteprima di traduzione leggera senza cambiare app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhält Take Screenshot und zeigt eine leichte Übersetzungsvorschau an, ohne die Apps zu wechseln."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"الإستلامات تأخذ \"سكرين طلقات وتظهر استعراضاً لترجمة الوزن الخفيف بدون تطبيقات التحويل"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получает Скриншот и показывает легкий предварительный просмотр перевода без переключения приложений."
          }
        }
      }
    },
    "Share a screenshot or image to translate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a screenshot or image to translate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请共享一张截图或图片以进行翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請共享一張截圖或圖片以進行翻譯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳するスクリーンショットや画像を共有してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez une capture ou une image à traduire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte una captura o imagen para traducir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역할 스크린샷이나 이미지를 공유하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe uma captura ou imagem para traduzir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi uno screenshot o un’immagine da tradurre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen Screenshot oder ein Bild zum Übersetzen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك لقطة شاشة أو صورة لترجمتها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь снимком экрана или изображением для перевода."
          }
        }
      }
    },
    "This image is too large. Share a single screen-sized screenshot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is too large. Share a single screen-sized screenshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片过大，请共享一张普通屏幕截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片過大，請共享一張普通螢幕截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が大きすぎます。通常のスクリーンショットを1枚共有してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image trop grande. Partagez une seule capture d’écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen es demasiado grande. Comparte una sola captura de pantalla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 너무 큽니다. 일반 스크린샷 한 장을 공유하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem muito grande. Compartilhe uma única captura de tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagine troppo grande. Condividi un solo screenshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist zu groß. Teile einen einzelnen Screenshot."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة كبيرة جداً. شارك لقطة شاشة واحدة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение слишком большое. Поделитесь одним снимком экрана."
          }
        }
      }
    },
    "Shared access is unavailable. Sign the app and extension with the same App Group and Keychain group, then open the app once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared access is unavailable. Sign the app and extension with the same App Group and Keychain group, then open the app once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享访问不可用。请为主 App 和扩展签入相同的 App Group 与 Keychain 组，并先打开一次主 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享訪問不可用。請為主 App 和擴充套件簽入相同的 App Group 與 Keychain 組，並先開啟一次主 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アクセスは利用できません。同じAppグループとKeychainグループでアプリと拡張機能に署名し、一度アプリを開きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès partagé n'est pas disponible. Signez l'application et l'extension avec le même groupe App et Keychain, puis ouvrez l'application une fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso compartido no está disponible. Firme la aplicación y la extensión con el mismo grupo App Group y Keychain, a continuación, abra la aplicación una vez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 액세스는 사용할 수 없습니다. 같은 앱 그룹 및 키 체인 그룹으로 앱과 확장을 표시하고 한 번 앱을 엽니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso compartilhado não está disponível. Assine o aplicativo e a extensão com o mesmo Grupo de aplicativos e grupo Keychain, e então abra o aplicativo uma vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso condiviso non è disponibile. Firma l'app e l'estensione con lo stesso gruppo App e Keychain, quindi apri l'app una volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsame Zugriff ist nicht verfügbar. Unterschreiben Sie die App und die Erweiterung mit derselben App-Gruppe und Schlüsselbund-Gruppe und öffnen Sie die App dann einmal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول المشترك غير متاح، وقّع على التطبيق والتمديد مع نفس مجموعة (آب) و(كيشاين)، ثمّ فتح التطبيق مرة واحدة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий доступ недоступен. Подпишите приложение и расширение с той же группой приложений и группой Keychain, а затем откройте приложение один раз."
          }
        }
      }
    },
