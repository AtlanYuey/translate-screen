    "Use the Action Button to capture and translate whatever is on your screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Action Button to capture and translate whatever is on your screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用操作按钮截取当前屏幕，并直接查看翻译结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用操作按鈕擷取當前螢幕，並直接檢視翻譯結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションボタンを使用して、画面上の何かをキャプチャして翻訳します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton Action pour capturer et traduire tout ce qui est sur votre écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el botón de acción para capturar y traducir lo que sea en su pantalla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 버튼을 사용하여 캡처하고 화면에 어떤 것을 번역합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão de ação para capturar e traduzir o que estiver na tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare il pulsante di azione per catturare e tradurre ciò che è sullo schermo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Aktionstaste, um zu erfassen und zu übersetzen, was auf Ihrem Bildschirm ist."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إستخدمي \"العمل بوتون\" للقبض و ترجمة ما هو على شاشتك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте кнопку действия, чтобы захватить и перевести все, что находится на вашем экране."
          }
        }
      }
    },
