    "Enable only for a vision-capable model. DeepSeek's text models cannot perform image OCR. Model availability depends on your provider.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable only for a vision-capable model. DeepSeek's text models cannot perform image OCR. Model availability depends on your provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对视觉模型开启。DeepSeek 的文字模型不能用于图像识别，具体能力以服务商和所选模型为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅對視覺模型開啟。DeepSeek 的文字模型不能用於影象識別，具體能力以服務商和所選模型為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像に対応したモデルだけで有効にしてください。DeepSeekのテキストモデルでは画像認識はできません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez uniquement pour un modèle acceptant les images. Les modèles texte DeepSeek ne font pas d’OCR d’image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa esta opción solo para modelos que admitan imágenes. Los modelos de texto de DeepSeek no hacen OCR de imágenes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 지원하는 모델에만 켜세요. DeepSeek 텍스트 모델은 이미지 문자 인식을 지원하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative apenas para modelos que aceitam imagens. Os modelos de texto DeepSeek não fazem OCR de imagens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva solo per modelli che supportano immagini. I modelli testuali DeepSeek non eseguono OCR su immagini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für bildfähige Modelle aktivieren. DeepSeeks Textmodelle können keine Bilderkennung ausführen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل هذا الخيار للنماذج التي تدعم الصور فقط. نماذج DeepSeek النصية لا تتعرف على نص الصور."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте только для моделей с поддержкой изображений. Текстовые модели DeepSeek не выполняют OCR изображений."
          }
        }
      }
    },
