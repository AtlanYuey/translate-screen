    "Some AI text has no verified local position. It is available in Full Text; only Vision-verified regions are overlaid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some AI text has no verified local position. It is available in Full Text; only Vision-verified regions are overlaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 AI 文字无法确认位置，已放入全文阅读；仅在本机验证过的位置覆盖译文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 AI 文字無法確認位置，已放入全文閱讀；僅在本機驗證過的位置覆蓋譯文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のAIテキストはローカルの位置を検証していません。フルテキストで利用可能です。ビジョン検証済みの地域のみが優先されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains textes de l'IA n'ont pas de position locale vérifiée. Il est disponible en texte intégral; seules les régions vérifiées par vision sont recouvertes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos textos de AI no tienen una posición local verificada. Está disponible en texto completo; sólo las regiones verificadas por Visión están superpuestas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 AI 텍스트는 검증된 로컬 위치가 없습니다. 전체 텍스트에서만 사용할 수 있습니다. Vision-verified 영역은 중복입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns textos de IA não têm posição local verificada. Está disponível no Texto Completo; apenas as regiões verificadas por Visão são sobrepostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni testi dell'IA non hanno una posizione locale verificata, è disponibile in testo completo; solo le regioni verificate dalla visione sono sovrapposte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige KI-Texte haben keine verifizierte lokale Position. Sie sind im Volltext verfügbar; nur Vision-verifizierte Regionen werden überlagert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولا يوجد موقع محلي متحقق منه في بعض النصوص الصادرة عن منظمة العفو الدولية، وهي متاحة في النص الكامل؛ ولا توجد سوى المناطق التي يشرف عليها التصور."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторый текст ИИ не имеет проверенной локальной позиции. Он доступен в Full Text; накладываются только проверяемые зрением области."
          }
        }
      }
    },
    "AI OCR was unavailable. Apple Vision was used locally; you can retry with another engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR was unavailable. Apple Vision was used locally; you can retry with another engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 识别不可用，已使用本机 Apple Vision。你可以换引擎重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 識別不可用，已使用本機 Apple Vision。你可以換引擎重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCRは使用できませんでした。Apple Visionはローカルで使用されていました。別のエンジンで再試すことができます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR n'était pas disponible. Apple Vision a été utilisé localement; vous pouvez réessayer avec un autre moteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR no estaba disponible. Apple Vision fue utilizado localmente; se puede reiniciar con otro motor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR은 사용할 수 없었습니다. Apple Vision는 현지에서 사용되었습니다. 다른 엔진과 재시동할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR estava indisponível. Apple Vision foi usado localmente; você pode tentar novamente com outro motor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'AI OCR non era disponibile. Apple Vision è stato utilizzato localmente; è possibile riprovare con un altro motore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR war nicht verfügbar. Apple Vision wurde lokal verwendet; Sie können es mit einem anderen Motor wiederholen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن هناك برمجيات غير متوفره الرؤية التطبيقية كانت تستخدم محلياً"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI OCR был недоступен. Apple Vision использовался локально; можно перепробовать с другим движком."
          }
        }
      }
    },
