    },
    "The AI service did not return the requested JSON. Try another model or use Apple’s engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service did not return the requested JSON. Try another model or use Apple’s engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服务未返回所需的 JSON，可更换模型或使用苹果引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服務未返回所需的 JSON，可更換模型或使用蘋果引擎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIサービスは、要求されたJSONを返さない。 別のモデルを試したり、Appleのエンジンを使用する。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service AI n'a pas retourné le JSON demandé. Essayez un autre modèle ou utilisez le moteur Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio AI no devolvió el JSON solicitado. Pruebe otro modelo o utilice el motor de Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스는 요청한 JSON을 반환하지 않았습니다. 다른 모델을 시도하거나 Apple의 엔진을 사용하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de IA não devolveu o JSON solicitado. Tente outro modelo ou use o motor da Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio AI non ha restituito il JSON richiesto. Prova un altro modello o utilizza il motore di Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Service hat das angeforderte JSON nicht zurückgegeben. Versuchen Sie ein anderes Modell oder verwenden Sie den Motor von Apple."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولم تُرد دائرة الاستخبارات المالية الطلب إلى الورقة المشتركة، بل جربت نموذجاً آخر أو استخدمت محرك آبل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба ИИ не вернула запрошенный JSON. Попробуйте другую модель или воспользуйтесь движком Apple."
          }
        }
      }
    },
    "The AI service returned invalid OCR regions. Local recognition is available as a fallback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service returned invalid OCR regions. Local recognition is available as a fallback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回的识别区域无效，可回退到本机识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回的識別區域無效，可回退到本機識別。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIサービスは無効な OCR 領域を返しました。ローカル認識はフォールバックとして利用できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'IA a retourné les régions non valides du ROC. La reconnaissance locale est disponible sous forme de recul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio AI devolvió regiones OCR inválidas. El reconocimiento local está disponible como retroceso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스는 잘못된 OCR 영역으로 반환됩니다. 로컬 인식은 fallback으로 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de IA devolveu regiões de OCR inválidas. O reconhecimento local está disponível como recurso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio AI ha restituito le regioni OCR non valide. Il riconoscimento locale è disponibile come un fallback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Dienst hat ungültige OCR-Regionen zurückgegeben. Die lokale Erkennung steht als Fallback zur Verfügung."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقد أعادت دائرة الاستخبارات المالية مناطق غير صالحة من مناطق مكتب الممثل الخاص للأمين العام، ويتاح الاعتراف المحلي كنتيجة للتراجع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба ИИ вернула недействительные регионы ОКР. Локальное распознавание доступно в качестве запасного варианта."
          }
        }
      }
    },
    "The translation service omitted or duplicated text regions. Retry or choose a different translation engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation service omitted or duplicated text regions. Retry or choose a different translation engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译服务遗漏或重复了文字区域，请重试或更换引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯服務遺漏或重複了文字區域，請重試或更換引擎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳サービスが省略または複製されたテキスト領域。異なる翻訳エンジンを再試行または選択します。"
          }
        },
        "fr": {
          "stringUnit": {
