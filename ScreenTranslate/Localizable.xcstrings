            "value": "La respuesta del servicio AI superó el límite de tamaño. Pruebe una captura de pantalla más pequeña."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스 응답은 크기 제한을 초과했습니다. 더 작은 스크린 샷을보십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do serviço de IA excedeu o limite de tamanho. Tente uma captura de tela menor."
          }
        },
        "it": {
