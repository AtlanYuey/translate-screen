    "Model defaults sends no reasoning override. Choose only parameters supported by your model; stronger reasoning can increase latency. Gemini's compatible API also accepts reasoning_effort on supported models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model defaults sends no reasoning override. Choose only parameters supported by your model; stronger reasoning can increase latency. Gemini's compatible API also accepts reasoning_effort on supported models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“模型默认”不额外设置思考参数。请按模型支持情况选择；思考强度越高，等待可能越久。Gemini 兼容接口的部分模型也支持 reasoning_effort。"
          }
        }
      }
    },
    "Custom values override the preset. For example: {\"temperature\":0.2,\"max_completion_tokens\":4096}. Do not put credentials here. Test Translation uses these same parameters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom values override the preset. For example: {\"temperature\":0.2,\"max_completion_tokens\":4096}. Do not put credentials here. Test Translation uses these same parameters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义值覆盖预设，例如：{\"temperature\":0.2,\"max_completion_tokens\":4096}。请勿填写密钥；“测试翻译”使用这里的同一组参数。"
          }
        }
      }
    },
    "Enter a JSON object of at most 16 KB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a JSON object of at most 16 KB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不超过 16 KB 的 JSON 对象。"
          }
        }
      }
    },
    "Model, messages, stream, tools, credentials and response count are managed by the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, messages, stream, tools, credentials and response count are managed by the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型、消息、流式输出、工具、密钥和返回数量由 App 管理，请勿在此覆盖。"
          }
        }
      }
    },
    "Use only one of max_tokens and max_completion_tokens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only one of max_tokens and max_completion_tokens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "max_tokens 与 max_completion_tokens 请只设置其中一个。"
          }
        }
      }
    },
    "Automatic sync is active. Changes are queued to iCloud; delivery depends on the account and network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic sync is active. Changes are queued to iCloud; delivery depends on the account and network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动同步已开启。修改会自动提交到 iCloud，其他设备的接收时间取决于账号与网络状态。"
          }
        }
      }
    },
    "Saved settings sync automatically after enabling. Changes are sent after a short pause; opening the app also checks other devices. Manual upload is only a fallback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved settings sync automatically after enabling. Changes are sent after a short pause; opening the app also checks other devices. Manual upload is only a fallback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后自动同步已保存的设置。修改会稍作合并后自动发送，打开 App 时也会检查其他设备的更新；手动上传仅作为备用。"
          }
        }
      }
    },
    "This signing profile does not permit iCloud settings sync. Re-sign with an iCloud Key-Value Store enabled profile and keep the same app identity on every device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signing profile does not permit iCloud settings sync. Re-sign with an iCloud Key-Value Store enabled profile and keep the same app identity on every device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前签名描述文件不允许 iCloud 设置同步。请使用支持 iCloud 键值存储的描述文件重新签名，并确保各设备使用相同的 App 身份。"
          }
        }
      }
    },
    "The model did not follow the selected target language. The original image is preserved. Choose another model or retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model did not follow the selected target language. The original image is preserved. Choose another model or retry."
