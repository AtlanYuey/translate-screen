    "The result fills the screen. Use the floating original icon to compare, and More for copy, full text or settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result fills the screen. Use the floating original icon to compare, and More for copy, full text or settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果画面铺满屏幕。悬浮原图按钮用于对比；复制、全文阅读及设置集中在更多菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果畫面鋪滿螢幕。懸浮原圖按鈕用於對比；複製、全文閱讀及設定集中在更多選單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は画面を埋めます。 フローティング元のアイコンを使用して、コピー、完全なテキスト、または設定の多くを比較します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat remplit l'écran. Utilisez l'icône d'origine flottante pour comparer, et Plus pour copier, texte complet ou paramètres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado llena la pantalla. Utilice el icono original flotante para comparar, y Más para copiar, texto completo o configuración."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과 화면을 채웁니다. 플로팅 원본 아이콘을 사용하여 비교하고 복사, 전체 텍스트 또는 설정을 위해 더 많은 것을 사용합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado preenche a tela. Use o ícone original flutuante para comparar, e mais para copiar, texto completo ou configurações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato riempie lo schermo. Utilizzare l'icona originale galleggiante per confrontare, e di più per copia, testo completo o impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis füllt den Bildschirm. Verwenden Sie das schwebende Originalsymbol zum Vergleichen und Mehr für Kopie, Volltext oder Einstellungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وتملأ النتيجة الشاشة، وتستعمل الشعار الأصلي العائم للمقارنة، والأكثر للنسخ أو النص الكامل أو البيئات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат заполняет экран. Используйте плавающий значок оригинала для сравнения, и больше для копирования, полного текста или настроек."
          }
        }
      }
    },
