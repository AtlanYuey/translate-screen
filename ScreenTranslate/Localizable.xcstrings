    "Pasting a key fetches the provider’s model list. If listing is unavailable, choose Other Model and enter its ID. Enable image input only for a vision-capable model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasting a key fetches the provider’s model list. If listing is unavailable, choose Other Model and enter its ID. Enable image input only for a vision-capable model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴密钥后会获取此服务商的模型列表。无法获取时，可选“其他模型”并填写模型名称。只有支持视觉的模型才应打开图像输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上密鑰後會取得此服務商的模型清單。無法取得時，可選「其他模型」並填寫模型名稱。只有支援視覺的模型才應開啟圖像輸入。"
          }
        }
      }
    },
