    "Test sends only the selected sample to this endpoint with the current key and model. Provider fees may apply. Saving alone sends no translation request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test sends only the selected sample to this endpoint with the current key and model. Provider fees may apply. Saving alone sends no translation request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击测试会使用当前密钥和模型，仅向此接口发送所选短句，翻译为目标语言；服务商可能收费。保存不会发起翻译请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊測試會使用目前密鑰和模型，僅向此介面傳送所選短句，翻譯為目標語言；服務商可能收費。儲存不會發起翻譯請求。"
          }
        }
      }
    },
    "The key stays visible for checking pasted text. It is saved only in this device’s Keychain, separately for each service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key stays visible for checking pasted text. It is saved only in this device’s Keychain, separately for each service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥明文显示，方便核对粘贴内容。每个服务的密钥独立存入本机钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密鑰明文顯示，方便核對貼上內容。每個服務的密鑰獨立存入本機鑰匙圈。"
          }
        }
      }
    },
    "Changing the endpoint clears a previously saved key. Paste a replacement for the new destination.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the endpoint clears a previously saved key. Paste a replacement for the new destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改接口地址会清除已载入的旧密钥，请为新地址重新粘贴密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改介面位址會清除已載入的舊密鑰，請為新位址重新貼上密鑰。"
          }
        }
      }
    },
    "Settings also sync through the shared Keychain. If your signing tool removes both sharing permissions, copy configuration from the main app and paste it here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings also sync through the shared Keychain. If your signing tool removes both sharing permissions, copy configuration from the main app and paste it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置也会通过共享钥匙串同步。如果签名工具移除了两种共享权限，请在主 App 中复制配置，再到这里粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定也會透過共用鑰匙圈同步。如果簽署工具移除了兩種共用權限，請在主 App 中拷貝設定，再到這裡貼上。"
          }
        }
      }
    },
