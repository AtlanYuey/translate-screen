    "Apple Vision and Apple Translation are the defaults and need no API key. Their language models may need a one-time system download. The app has no screenshot-upload server, analytics, account or ads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision and Apple Translation are the defaults and need no API key. Their language models may need a one-time system download. The app has no screenshot-upload server, analytics, account or ads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用 Apple Vision 与苹果翻译，无需 API Key。系统可能需要首次下载语言模型。App 没有自有截图上传服务器、统计追踪、账号或广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設使用 Apple Vision 與蘋果翻譯，無需 API Key。系統可能需要首次下載語言模型。App 沒有自有截圖上傳伺服器、統計追蹤、賬號或廣告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準は端末内のApple VisionとApple翻訳で、キーは不要です。初回のみ言語モデルのダウンロードが必要な場合があります。独自の画像サーバー、アカウント、解析、広告はありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision et Traduction Apple sont les moteurs locaux par défaut, sans clé. Les modèles peuvent nécessiter un téléchargement initial. Aucun serveur d’images, compte, suivi ou publicité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto se usan Apple Vision y Apple Translation en el dispositivo, sin clave. Los modelos pueden requerir una descarga inicial. Sin servidor propio de imágenes, cuenta, analítica ni anuncios."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 키가 필요 없는 기기 내 Apple Vision과 Apple 번역입니다. 처음에는 언어 모델을 다운로드해야 할 수 있습니다. 자체 이미지 서버, 계정, 분석 및 광고는 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision e Tradução Apple são os padrões locais, sem chave. Os modelos podem exigir um download inicial. Sem servidor próprio de imagens, conta, análise ou anúncios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision e Traduzione Apple funzionano sul dispositivo senza chiave. I modelli possono richiedere un download iniziale. Nessun server immagini, account, analisi o pubblicità."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard sind Apple Vision und Apple Übersetzen auf dem Gerät, ohne Schlüssel. Sprachmodelle müssen eventuell einmal geladen werden. Keine eigenen Bildserver, Konten, Analysen oder Werbung."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحركات الافتراضية هي Apple Vision وترجمة Apple على الجهاز دون مفتاح. قد تحتاج النماذج إلى تنزيل أولي. لا خادم صور خاص ولا حساب أو تحليلات أو إعلانات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию Apple Vision и перевод Apple работают на устройстве без ключа. Может потребоваться загрузка языковых моделей. Нет своего сервера изображений, аккаунта, аналитики и рекламы."
          }
        }
      }
    },
    "Temporary by default": {
      "extractionState": "manual",
      "localizations": {
