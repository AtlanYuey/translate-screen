    "Tap a saved service to switch instantly. Keys and other configurations are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a saved service to switch instantly. Keys and other configurations are kept."
          }
        },
        "zh-Hans": {
