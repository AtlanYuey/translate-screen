        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未遵守选定的目标语言。已保留原图，请更换模型或重试。"
          }
        }
      }
    },
    "The translation request was interrupted. The original image is still here; retry to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation request was interrupted. The original image is still here; retry to continue."
