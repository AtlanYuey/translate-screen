    "Tap Add Screenshot Shortcut below and confirm the system import. No manual action assembly is needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add Screenshot Shortcut below and confirm the system import. No manual action assembly is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方按钮，确认系统导入，即可添加完整指令，无需手工拼装动作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選下方按鈕，確認系統匯入，即可新增完整指令，無需手工拼裝動作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ スクリーンショットのショートカットを追加し、システムインポートを確認します。 手動アクションアセンブリは必要ありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Ajouter une capture d'écran Raccourci ci-dessous et confirmez l'importation du système. Aucune action manuelle n'est nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Añadir Captura de Pantalla Ataque a continuación y confirme la importación del sistema. No se necesita montaje manual de acción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 스크린 샷 단축키를 탭하고 시스템 가져 오기를 확인합니다. 수동 작업 어셈블리가 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Adicionar um Atalho de Captura de Tela abaixo e confirme a importação do sistema. Não é necessário nenhum conjunto de ação manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare Aggiungi Screenshot scorciatoia di seguito e confermare l'importazione del sistema."
          }
        },
        "de": {
