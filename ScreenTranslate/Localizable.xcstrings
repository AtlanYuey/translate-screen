          }
        }
      }
    },
    "The AI service rate or usage limit was reached. Wait, or use Apple’s free engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service rate or usage limit was reached. Wait, or use Apple’s free engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服务已达到频率或额度限制，请稍后再试，或使用免费苹果引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服務已達到頻率或額度限制，請稍後再試，或使用免費蘋果引擎。"
          }
